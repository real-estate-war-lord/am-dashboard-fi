.env
__pycache__/
.DS_Store
*.log
.venv/

# raw pulls are re-downloadable and never committed — only the *.meta.json stamps are
data/raw/**
!data/raw/**/
!data/raw/**/*.meta.json
data/geo/raw/

# built artefacts
dist/index.html
dist/fixture.html
dist/geo/
dist/micro/
dist/services/
dist/public/
tests/fixture_*.json

# source files re-downloaded per docs/SOURCES.md (the extracted CSVs are committed)
data/external/*.xlsx
data/external/*.xls
data/external/*.pdf
data/external/raw/

# local run logs
validate.txt
fetch.txt
probe.txt

# the address lookup is ~65 MB rebuilt from data/processed/addr on every deploy
dist/addr/

# the per-route screenshots are rebuilt on demand by `make ui SHOTS=1` — kept locally, not in git
docs/ui_v2/
